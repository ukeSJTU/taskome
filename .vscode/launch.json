{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server: Debug",
      "type": "node-terminal",
      "request": "launch",
      "command": "mise run //apps/server:dev",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/**/node_modules/**"]
    },
    {
      "name": "Console: Debug",
      "type": "node-terminal",
      "request": "launch",
      "command": "mise run //apps/console:dev",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/**/node_modules/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/apps/console",
        "killOnServerStop": true
      }
    },
    {
      "name": "Web: Debug",
      "type": "node-terminal",
      "request": "launch",
      "command": "mise run //apps/web:dev",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/**/node_modules/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/apps/web",
        "killOnServerStop": true
      }
    },
    {
      "name": "CLI: Debug",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/cli",
      "cwd": "${workspaceFolder}/apps/cli",
      "args": []
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Server + Console",
      "configurations": ["Server: Debug", "Console: Debug"],
      "stopAll": true
    }
  ]
}
