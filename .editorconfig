root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,jsonc,yaml,yml}]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{cif,pdb}]
trim_trailing_whitespace = false

[*.{bash,sh,zsh}]
indent_size = 2

[*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,css,scss,html}]
indent_size = 2

[*.toml]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = unset
