    "/v1/me": {
      "get": {
        "description": "Return the authenticated caller's normalized identity.",
        "operationId": "getCurrentIdentity",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
