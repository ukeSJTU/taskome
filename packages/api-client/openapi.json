{
  "components": {
    "schemas": {
      "CreateInputFileRequest": {
        "description": "Validated REST input for creating an immutable Input File.",
        "properties": {
          "original_filename": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Original Filename",
            "type": "string"
          },
          "size_bytes": {
            "maximum": 52428800.0,
            "minimum": 1.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "original_filename",
          "size_bytes"
        ],
        "title": "CreateInputFileRequest",
        "type": "object"
      },
      "CreateJobRequest": {
        "description": "Validated REST input for submitting one Job.",
        "properties": {
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "task_name": {
            "maxLength": 63,
            "minLength": 1,
            "title": "Task Name",
            "type": "string"
          },
          "task_server_name": {
            "maxLength": 63,
            "minLength": 1,
            "title": "Task Server Name",
            "type": "string"
          }
        },
        "required": [
          "task_server_name",
          "task_name",
          "params"
        ],
        "title": "CreateJobRequest",
        "type": "object"
      },
      "CredentialKind": {
        "description": "Credential channels normalized into a principal.",
        "enum": [
          "session_jwt",
          "oauth_access_token",
          "personal_api_key"
        ],
        "title": "CredentialKind",
        "type": "string"
      },
      "DownloadUrlResponse": {
        "description": "Caller-visible signed download URL and expiry.",
        "properties": {
          "download_url": {
            "title": "Download Url",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "download_url",
          "expires_at"
        ],
        "title": "DownloadUrlResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "enum": [
              "alive",
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "status",
          "timestamp"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Identity": {
        "description": "Normalized identity returned by the REST authentication endpoint.",
        "properties": {
          "credential_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credential Id"
          },
          "credential_kind": {
            "$ref": "#/components/schemas/CredentialKind"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "credential_kind",
          "credential_id"
        ],
        "title": "Identity",
        "type": "object"
      },
      "JobListResponse": {
        "description": "A page of the caller's own Jobs, newest first.",
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobResponse"
            },
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "title": "JobListResponse",
        "type": "object"
      },
      "JobResponse": {
        "description": "Caller-visible Job state, frozen params, and result.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error_detail": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Detail"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "params_schema_version": {
            "title": "Params Schema Version",
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "task_name": {
            "title": "Task Name",
            "type": "string"
          },
          "task_server_name": {
            "title": "Task Server Name",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "task_server_name",
          "task_name",
          "params",
          "params_schema_version",
          "result",
          "error_detail",
          "created_at",
          "updated_at"
        ],
        "title": "JobResponse",
        "type": "object"
      },
      "JobStatus": {
        "description": "A Job's lifecycle state (CONTEXT.md's Job definition).",
        "enum": [
          "queued",
          "running",
          "completed",
          "failed"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "request_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "alive",
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "status",
          "timestamp",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "UploadUrlResponse": {
        "description": "Caller-visible upload id, signed URL, and expiry.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "upload_url": {
            "description": "PUT with the declared Content-Length and If-None-Match: *; both headers are signed.",
            "title": "Upload Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "upload_url",
          "expires_at"
        ],
        "title": "UploadUrlResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "location",
          "message",
          "code"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      },
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "taskome-gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Report that the worker event loop is serving requests.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report whether the initialized Gateway can reach DB and Redis concurrently.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/input-files": {
      "post": {
        "description": "Allocate an Input File and return its constrained upload URL.",
        "operationId": "createInputFile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInputFileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadUrlResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Create Input File",
        "tags": [
          "input-files"
        ]
      }
    },
