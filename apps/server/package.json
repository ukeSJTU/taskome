{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:export": "tsx scripts/export-openapi.ts",
    "auth:generate": "auth generate --output ./src/db/schema/auth.ts --yes",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch src/index.ts",
    "lint": "oxlint --fix .",
    "lint:check": "oxlint --deny-warnings --report-unused-disable-directives .",
    "start": "node dist/index.mjs",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-openapi": "^1.6.1",
    "@scalar/hono-api-reference": "^0.11.14",
    "@taskome/env": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.2",
    "evlog": "^2.22.4",
    "hono": "^4.12.32",
    "pg": "^8.22.0",
    "stoker": "^2.0.1",
    "unicode-case-folding": "1.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@taskome/config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "4.1.11",
    "auth": "catalog:",
    "drizzle-kit": "^0.31.10",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  }
}
