# App
ENVIRONMENT=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/taskome
SEAWEEDFS_INTERNAL_ENDPOINT=http://localhost:8333
# Defaults to the internal endpoint in development; set this to the public URL in deployment.
# SEAWEEDFS_PUBLIC_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=taskome-dev
SEAWEEDFS_SECRET_KEY=taskome-dev-secret-change-me
SEAWEEDFS_BUCKET=taskome
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks

# Observability
OTEL_SERVICE_NAME=taskome-gateway
# Send traces and logs to the local otel-gui viewer. Comment out to opt out.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional shared or per-signal header and endpoint overrides for advanced routing.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20token
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20token
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=authorization=Bearer%20token
