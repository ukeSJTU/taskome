# App
# APP_ENVIRONMENT=development
# LOG_LEVEL=INFO
# DOCS_ENABLED=true

# Database
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/taskome

# Redis readiness dependency
# REDIS_URL=redis://localhost:6379/0
# DATABASE_TIMEOUT_SECONDS=5
# REDIS_TIMEOUT_SECONDS=2
# SEAWEEDFS_CONNECT_TIMEOUT_SECONDS=3
# SEAWEEDFS_IO_TIMEOUT_SECONDS=10
# JWKS_TIMEOUT_SECONDS=5
# OTEL_SHUTDOWN_TIMEOUT_SECONDS=5
# REQUEST_BODY_MAX_BYTES=4194304
# MCP_MESSAGE_MAX_BYTES=1048576

# Storage
SEAWEEDFS_SECRET_KEY=taskome-dev-secret-change-me
# SEAWEEDFS_INTERNAL_ENDPOINT=http://localhost:8333
# SEAWEEDFS_PUBLIC_ENDPOINT=http://localhost:8333
# SEAWEEDFS_ACCESS_KEY=taskome-dev
# SEAWEEDFS_BUCKET=taskome

# Auth
# BETTER_AUTH_URL=http://localhost:3000
# WEB_INTERNAL_URL=http://localhost:3000
# GATEWAY_PUBLIC_URL=http://localhost:8000
# Production Compose uses https://example.com for BETTER_AUTH_URL,
# http://web:3000 for WEB_INTERNAL_URL, and https://api.example.com publicly.
WEB_GATEWAY_HMAC_SECRET=replace-with-the-same-dedicated-web-gateway-secret

# Observability
# OTEL_SERVICE_NAME=taskome-gateway
# Send traces and logs to the local otel-gui viewer.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20token
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20token
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=authorization=Bearer%20token
