# App
# APP_ENVIRONMENT=development
# LOG_LEVEL=info
# DOCS_ENABLED=true

# Gateway (Gateway -> this Task Server, HMAC-signed per ADR-0007)
GATEWAY_INTERNAL_URL=http://localhost:8000
# Distinct per Task Server -- never reuse another server's secret (WEB_GATEWAY_HMAC_SECRET
# included). Must be at least 32 bytes.
GATEWAY_TASK_HMAC_SECRET=taskome-local-fpocket-gateway-hmac-secret-change-me
# GATEWAY_SIGNATURE_MAX_AGE_SECONDS=300

# Storage (this Task Server -> SeaweedFS, restricted to the fpocket/ output prefix)
SEAWEEDFS_INTERNAL_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=taskome-dev
SEAWEEDFS_SECRET_KEY=taskome-dev-secret-change-me
# SEAWEEDFS_BUCKET=taskome
# SEAWEEDFS_CONNECT_TIMEOUT_SECONDS=3
# SEAWEEDFS_IO_TIMEOUT_SECONDS=30

# Execution
# WORKDIR_ROOT=/tmp
# MAX_CONCURRENT_JOBS=1
# REQUEST_BODY_MAX_BYTES=4194304
# MCP_MESSAGE_MAX_BYTES=1048576
# HTTP_CONNECT_TIMEOUT_SECONDS=3
# HTTP_IO_TIMEOUT_SECONDS=30

# The vendored fpocket binary. The Dockerfile sets this to /usr/local/bin/fpocket;
# for local (non-Docker) runs, point it at the binary `compute:build` produces.
# FPOCKET_BINARY=./compute/bin/fpocket

# Observability
# OTEL_SERVICE_NAME=fpocket
# Send traces and logs to the local otel-gui viewer.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20token
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20token
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=authorization=Bearer%20token
