# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskome

# Auth
BETTER_AUTH_SECRET=replace-with-a-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000

# Observability
# Next.js sets NODE_ENV automatically for each run command; do not override it here.
# LOG_LEVEL defaults to "info" when unset.
LOG_LEVEL=info
# OTEL_SERVICE_NAME defaults to "taskome-web" when unset.
OTEL_SERVICE_NAME=taskome-web
# Send traces and logs to the local otel-gui viewer. Comment out to opt out.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional per-signal log endpoint override.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
