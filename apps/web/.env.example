# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskome

# Auth
BETTER_AUTH_SECRET=replace-with-a-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGIN=http://localhost:3000
WEB_GATEWAY_HMAC_SECRET=replace-with-a-separate-secret-of-at-least-32-characters

# Gateway
# GATEWAY_PUBLIC_URL=http://localhost:8000
# GATEWAY_INTERNAL_URL=http://localhost:8000
# Production Compose uses https://api.example.com publicly and http://gateway:8000 internally.

# Observability
# Next.js sets NODE_ENV automatically for each run command; do not override it here.
# LOG_LEVEL=debug
# OTEL_SERVICE_NAME=taskome-web
# Send traces and logs to the local otel-gui viewer.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
