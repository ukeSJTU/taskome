# Copy to the repository root as .env before running the production Compose stack.
WEB_ADDRESS=https://example.com
DOCS_ADDRESS=https://docs.example.com
API_ADDRESS=https://api.example.com

BETTER_AUTH_URL=https://example.com
WEB_PUBLIC_URL=http://xdenovoai.com
AUTH_TRUSTED_ORIGIN=https://example.com
GATEWAY_PUBLIC_URL=https://api.example.com

# These two secrets have different owners and must not be reused.
BETTER_AUTH_SECRET=replace-with-a-secret-of-at-least-32-characters
WEB_GATEWAY_HMAC_SECRET=replace-with-a-separate-secret-of-at-least-32-characters

# Browser-direct object transfer allows only the Web origin.
SEAWEEDFS_ALLOWED_ORIGINS=https://example.com
