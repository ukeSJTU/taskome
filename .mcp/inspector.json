{
  "mcpServers": {
    "taskome-gateway": {
      "type": "streamable-http",
      "url": "http://localhost:8000/mcp",
      "protocolEra": "modern",
      "oauth": {
        "scopes": ["taskome"]
      },
      "connectionTimeout": 10000,
      "requestTimeout": 60000,
      "modernLogLevel": "info",
      "maxFetchRequests": 200
    }
  }
}
